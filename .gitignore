# Composer
# vendor/ は追跡しない（毎回 composer install する）が、composer.lock は追跡する。
# 無いと composer install が実質 composer update になり、依存の新しい版が
# 予告なく本番へ入る。PR で走る CI が無いため、壊れたことに気づくのは本番実行時になる。
vendor/

# デバッグ用（--setup 実行時のみ生成）
debug_*.png
debug_page.html

# 実行ログ（GitHub Actions のログビューアで確認できるため追跡しない）
monitor.log

# PHP キャッシュ
*.cache

# 実行結果（本番は Cloudflare の保管先に置くのでリポジトリには戻さない）。
# 開発中に --dry-run を付けずに実行すると手元に生成されるが、中身は UR から
# 取った物件名・家賃・間取りなので **コミットしないこと**。
state.json

# セットアップウィザード（tools/setup.mjs）の生成物。
# KV の ID を含む wrangler.local.toml は実値なので追跡しない。雛形の
# wrangler.toml は汚さず、これを別に生成することで両立させている。
trigger/wrangler.local.toml

# 進捗の記録。秘密情報は書かない設計だが、環境固有の情報なので追跡しない。
tools/.setup-state.json

# --mock（模擬実行）の生成物。本物の config.json / docs/ には触れず、
# ここへ出力を逃がしている。進捗の記録も本番とは別ファイルにしてある。
tools/.mock-run/
tools/.setup-state.mock.json
